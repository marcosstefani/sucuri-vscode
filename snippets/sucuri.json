{
    "If Condition": {
        "prefix": "if",
        "body": [
            "<if ${1:condition}>",
            "\t$0",
            "<endif>"
        ],
        "description": "Conditional block (if / endif)"
    },
    "If-Elif-Else Condition": {
        "prefix": "ife",
        "body": [
            "<if ${1:condition}>",
            "\t$2",
            "<elif ${3:other_condition}>",
            "\t$4",
            "<else>",
            "\t$0",
            "<endif>"
        ],
        "description": "Full conditional block with elif and else"
    },
    "Elif Clause": {
        "prefix": "elif",
        "body": [
            "<elif ${1:condition}>"
        ],
        "description": "elif clause of a conditional block"
    },
    "Else Clause": {
        "prefix": "else",
        "body": [
            "<else>"
        ],
        "description": "else clause of a conditional block"
    },
    "For Loop": {
        "prefix": "for",
        "body": [
            "<for ${1:item} in ${2:collection}>",
            "\t$0",
            "<endfor>"
        ],
        "description": "Loop block (for / endfor). Access items with #item"
    },
    "Include Template": {
        "prefix": "include",
        "body": [
            "include ${1:path/to/template}"
        ],
        "description": "Import an external .suc template as a macro"
    },
    "Inject Template": {
        "prefix": "inject",
        "body": [
            "+${1:template_name}"
        ],
        "description": "Inject a previously included macro"
    },
    "Inject Template with Parameters": {
        "prefix": "injectp",
        "body": [
            "+${1:template_name}(${2:param}=\"${3:value}\")"
        ],
        "description": "Inject a macro passing inline parameters"
    },
    "Pipe Text": {
        "prefix": "|",
        "body": [
            "| ${1:Multi-line text}"
        ],
        "description": "Start a multi-line text line"
    },
    "Code Block": {
        "prefix": "code",
        "body": [
            "pre",
            "\tcode",
            "\t\t| ${1:code line}",
            "\t\t| $0"
        ],
        "description": "Literal multi-line code block (pre + code + pipe lines)"
    },
    "Extends Layout": {
        "prefix": "extends",
        "body": [
            "extends ${1:layout}",
            "",
            "block ${2:content}",
            "\t$0"
        ],
        "description": "Inherit a parent layout and define a content block"
    },
    "Block": {
        "prefix": "block",
        "body": [
            "block ${1:name}",
            "\t$0"
        ],
        "description": "Define a named block region for template inheritance"
    },
    "CSS Injection": {
        "prefix": "css",
        "body": [
            "css ${1:static/css/style.css}"
        ],
        "description": "Inject a CSS file as an inline <style> tag"
    },
    "JS Injection": {
        "prefix": "js",
        "body": [
            "js ${1:static/js/app.js}"
        ],
        "description": "Inject a JS file as an inline <script> tag"
    },
    "List Built-in": {
        "prefix": "list",
        "body": [
            "list(${1:items} class=\"${2:list}\")"
        ],
        "description": "Render an array as a <ul>/<li> list"
    },
    "Checkbox List Built-in": {
        "prefix": "listck",
        "body": [
            "list(${1:items} ${2:checked_items} class=\"${3:survey}\")"
        ],
        "description": "Render an array as checkboxes, checking the values of the second array"
    },
    "Table Built-in": {
        "prefix": "table",
        "body": [
            "table(${1:heads} ${2:rows} ${3:footers} class=\"${4:table}\" id=\"${5:table-id}\")"
        ],
        "description": "Render arrays as a full HTML table (thead, tbody, tfoot)"
    },
    "Watch Block": {
        "prefix": "watch",
        "body": [
            "watch ${1:state_key}",
            "\t$0"
        ],
        "description": "Reactive block re-rendered by the live server when the state key changes"
    },
    "Variable": {
        "prefix": "var",
        "body": [
            "{${1:variable}}"
        ],
        "description": "Interpolate a context variable (HTML-escaped)"
    },
    "Filtered Variable": {
        "prefix": "filter",
        "body": [
            "{${1:variable} | ${2|upper,lower,title,safe|}}"
        ],
        "description": "Interpolate a context variable applying a filter"
    },
    "HTML Skeleton": {
        "prefix": "html5",
        "body": [
            "html",
            "\thead",
            "\t\ttitle ${1:Page title}",
            "\tbody",
            "\t\t$0"
        ],
        "description": "Basic HTML document skeleton"
    }
}
